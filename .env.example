# ==============================================================================
# OpenMausBot + 9Router Autonomous AI Agent Platform - Environment Variables
# ==============================================================================
# Copy this file to `.env` before running `docker compose up` or local scripts.

# --- General Application ---
APP_NAME=openmausbot-platform
APP_ENV=development
LOG_LEVEL=INFO

# --- 9Router Unified AI Gateway ---
# Internal Docker URL: http://9router:20128/v1
# Localhost URL:       http://localhost:20128/v1
NINE_ROUTER_BASE_URL=http://9router:20128/v1
NINE_ROUTER_API_KEY=9router-local-gateway-key
NINE_ROUTER_PORT=20128
NINE_ROUTER_TIMEOUT_SECONDS=60
NINE_ROUTER_MAX_RETRIES=3
NINE_ROUTER_RETRY_BASE_DELAY=0.5

# Virtual Model Aliases (mapped in 9router/9router-config.yaml)
MODEL_ALIAS_PLANNER=agent-planner
MODEL_ALIAS_EXECUTOR=agent-executor
MODEL_ALIAS_REVIEWER=agent-reviewer

# --- Upstream LLM Provider Keys (used ONLY by 9Router, NEVER by OpenMausBot) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
ANTHROPIC_API_KEY=sk-ant-replace-me
OPENAI_API_KEY=sk-proj-replace-me
GEMINI_API_KEY=AIza-replace-me
GROQ_API_KEY=gsk_replace-me
DEEPSEEK_API_KEY=sk-deepseek-replace-me

# --- Redis (Task Queue & Short-Term Working Memory) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_TASK_QUEUE_KEY=openmausbot:tasks:queue
REDIS_MEMORY_TTL_SECONDS=3600

# --- PostgreSQL (Persistent State & Execution History) ---
POSTGRES_USER=openmausbot
POSTGRES_PASSWORD=openmausbot_secret_change_me
POSTGRES_DB=openmausbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://openmausbot:openmausbot_secret_change_me@postgres:5432/openmausbot_db

# --- OpenMausBot API & Webhook Server ---
API_HOST=0.0.0.0
API_PORT=8000
WEBHOOK_SECRET=replace-with-hmac-webhook-secret

# --- OpenMausBot Worker ---
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_CONCURRENCY=2
EXECUTOR_MAX_TOOL_ITERATIONS=6
SCRAPER_TIMEOUT_SECONDS=15
